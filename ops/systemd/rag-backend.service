[Unit]
Description=SDM RAG Backend
After=network-online.target postgresql@14-main.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=cicero
WorkingDirectory=/home/cicero/.openclaw/workspace/Backend_SDM_RAG
EnvironmentFile=/home/cicero/.openclaw/workspace/Backend_SDM_Test/.env
ExecStart=/usr/bin/env PORT=3001 NODE_ENV=production RAG_STORAGE=postgres LITELLM_BASE_URL=http://127.0.0.1:4000/v1 LITELLM_MODEL=copilot-rag LITELLM_MASTER_KEY=sk-sdm-rag-local /usr/bin/node /home/cicero/.openclaw/workspace/Backend_SDM_RAG/src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
